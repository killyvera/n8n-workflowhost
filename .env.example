# Copy to `.env` for docker compose (do not commit secrets).
# Local defaults → http://localhost:5678
# Production (Muelle / VM) → set public HTTPS URLs below.

# --- Public URL / webhooks (required on n8n.workflowhost.com) ---
N8N_HOST_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_PROXY_HOPS=0
# Production example:
# N8N_HOST=n8n.workflowhost.com
# N8N_PROTOCOL=https
# N8N_EDITOR_BASE_URL=https://n8n.workflowhost.com/
# N8N_WEBHOOK_URL=https://n8n.workflowhost.com/
# N8N_PROXY_HOPS=1

GENERIC_TIMEZONE=America/Mexico_City
TZ=America/Mexico_City

# REQUIRED — keep STABLE across redeploys or encrypted credentials become unreadable
N8N_ENCRYPTION_KEY=change-me-before-production

# Telemetry off by default for this fork
N8N_DIAGNOSTICS_ENABLED=false

# Expression engine (also defaulted in Dockerfile runtime)
# N8N_EXPRESSION_ENGINE=legacy

# Optional: only needed on older images that still list deleted EE modules.
# N8N_DISABLED_MODULES=dynamic-credentials,workflow-reviews

# --- PostgreSQL (persist users, workflows, executions metadata) ---
# Local compose: host "postgres" is the compose service name (set in docker-compose.yml).
# Muelle/VM: point HOST at your managed Postgres (not inside the n8n Dockerfile).
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=n8n-change-me
DB_POSTGRESDB_SCHEMA=public
