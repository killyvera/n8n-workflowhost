# Copy to `.env` for the n8n service (do not commit secrets).
#
# Local compose defaults use host "postgres" and port 5678.
# Muelle (n8n.workflowhost.com) values are documented below — match .env / platform UI.

# --- Listen ---
# Muelle: Caddy maps host :20001 → container :8000 → set N8N_PORT=8000
N8N_PORT=8000
N8N_LISTEN_ADDRESS=0.0.0.0
N8N_HOST_PORT=8000

# --- Public URL / webhooks ---
# PROTOCOL stays http behind Caddy (TLS terminates at the proxy).
N8N_HOST=n8n.workflowhost.com
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=https://n8n.workflowhost.com/
N8N_WEBHOOK_URL=https://n8n.workflowhost.com/
N8N_PROXY_HOPS=1

# Local example:
# N8N_PORT=5678
# N8N_HOST=localhost
# N8N_EDITOR_BASE_URL=http://localhost:5678/
# N8N_WEBHOOK_URL=http://localhost:5678/
# N8N_PROXY_HOPS=0

GENERIC_TIMEZONE=America/Mexico_City
TZ=America/Mexico_City

# REQUIRED — keep STABLE across redeploys or encrypted credentials become unreadable
N8N_ENCRYPTION_KEY=change-me-before-production

N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_PUBLIC_API_DISABLED=false
N8N_EXPRESSION_ENGINE=legacy

# --- PostgreSQL ---
# Muelle: use the Postgres *container/service id* on the shared network (not localhost).
# Example: DB_POSTGRESDB_HOST=svc_191de5351bc3454d85d4e912270b6fe4
# Local compose: DB_POSTGRESDB_HOST=postgres
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=svc_191de5351bc3454d85d4e912270b6fe4
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=change-me-match-env-pg
DB_POSTGRESDB_SCHEMA=public
