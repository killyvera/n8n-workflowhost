# Copy to `.env.pg` for the Postgres container (do not commit secrets).
# Credentials MUST match n8n DB_POSTGRESDB_USER / PASSWORD / DATABASE.

POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=n8n

DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=change-me-strong-password
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_PORT=5432

PGVECTOR_TAG=pg16
TZ=America/Mexico_City
PGTZ=America/Mexico_City
